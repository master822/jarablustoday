                            @csrf
                            <button class="btn btn-success">
                                موافقة ونشر
                            </button>
                        </form>
                    @endif

                    @if($item->status !== 'rejected')
                        <form method="POST"
                              action="{{ route('admin.properties.reject', $item->id) }}"
                              class="d-inline">
                            @csrf
                            <button class="btn btn-danger">
                                رفض
                            </button>
                        </form>
                    @endif
